# Environment
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/monorepo
MONGO_DB_NAME=monorepo

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# AWS / LocalStack
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566
S3_BUCKET_NAME=monorepo-uploads

# Firebase
FIREBASE_PROJECT_ID=monorepo-dev
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIREBASE_FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199

# API Service
API_PORT=3000
API_HOST=localhost
JWT_SECRET=your-super-secret-jwt-key-change-in-production
API_RATE_LIMIT=100

# Python Algorithm Service
ALGORITHM_SERVICE_PORT=5000
ALGORITHM_SERVICE_HOST=localhost

# Mobile App
MOBILE_API_URL=http://localhost:3000

# Logging
LOG_LEVEL=info
